# Use the same OAuth web client ID configured as GOOGLE_CLIENT_ID in the backend.
VITE_GOOGLE_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com

# Spotify Developer Dashboard > your app > Settings > Client ID
VITE_SPOTIFY_CLIENT_ID=your-spotify-client-id
# Must exactly match a Redirect URI registered in your Spotify app settings.
VITE_SPOTIFY_REDIRECT_URI=http://127.0.0.1:8000/
