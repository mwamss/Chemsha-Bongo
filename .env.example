# Chemsha Bongo Environment Variables
# Copy this file to .env for local configuration: cp .env.example .env
# DO NOT commit real secrets or credentials to version control.

# Application Environment
ENVIRONMENT=development
DEBUG=true
PORT=8000

# Security & Authentication
# Generate a secure 32+ character key using: openssl rand -hex 32
SECRET_KEY=replace_with_a_secure_random_secret_key_minimum_32_chars
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALGORITHM=HS256
GOOGLE_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com

# CSRF Protection
CSRF_SECRET=replace_with_a_secure_csrf_secret_key

# Cookie Security (set to true in production with HTTPS)
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=

# Database Configuration (PostgreSQL 16)
# Format: postgresql+psycopg://<username>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql+psycopg://chemsha_user:chemsha_secret_change_me@localhost:5432/chemsha_bongo_db

# Docker Compose Environment Defaults
POSTGRES_USER=chemsha_user
POSTGRES_PASSWORD=chemsha_secret_change_me
POSTGRES_DB=chemsha_bongo_db
POSTGRES_PORT=5432

# CORS Configuration (Comma-separated origins)
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:3000

# Leaderboard & Game Engine Settings
CHALLENGE_TIMEZONE=UTC
DAILY_BLITZ_ROUNDS_REQUIRED=3
MAX_THEORETICAL_SCORE_PER_ROUND=5000
