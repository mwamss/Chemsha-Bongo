# Copy to .env for Docker Compose. Replace every placeholder before deployment.
POSTGRES_USER=chemsha_user
POSTGRES_PASSWORD=replace-with-a-long-random-database-password
POSTGRES_DB=chemsha_bongo
DATABASE_URL=postgresql+psycopg://chemsha_user:replace-with-a-long-random-database-password@db:5432/chemsha_bongo

SECRET_KEY=replace-with-at-least-32-random-characters
CSRF_SECRET=replace-with-another-unique-32-character-secret
ENVIRONMENT=production
DEBUG=false
COOKIE_SECURE=true
# Same-origin app hosting needs no CORS. If frontend is separate, set exact HTTPS origins.
CORS_ORIGINS=

GOOGLE_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com
VITE_SPOTIFY_CLIENT_ID=your-spotify-client-id
VITE_SPOTIFY_REDIRECT_URI=https://your-domain.example/
